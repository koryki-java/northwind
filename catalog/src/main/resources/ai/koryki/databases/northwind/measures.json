{
  "tables": {
    "orders": [
      {
        "name": "total_freight",
        "label": "Total freight",
        "expression": "sum(freight)",
        "concept": {
          "typeFamily": "DECIMAL"
        }
      },
      {
        "name": "order_count",
        "label": "Orders",
        "expression": "count(order_id)"
      },
      {
        "name": "avg_freight",
        "label": "Average freight",
        "expression": "avg(freight)",
        "concept": {
          "typeFamily": "DECIMAL"
        }
      },
      {
        "name": "big_freight",
        "label": "Freight of orders above 100",
        "expression": "sum(case(freight > 100, freight))",
        "concept": {
          "typeFamily": "DECIMAL"
        }
      }
    ],
    "order_details": [
      {
        "name": "units",
        "label": "Units sold",
        "expression": "sum(quantity)",
        "concept": {
          "typeFamily": "INTEGER"
        }
      },
      {
        "name": "revenue",
        "label": "Revenue",
        "expression": "sum(unit_price * quantity)",
        "concept": {
          "typeFamily": "DECIMAL"
        }
      },
      {
        "name": "beverage_revenue",
        "label": "Beverage revenue",
        "description": "Revenue of the line items whose product is in category 1 (beverages): reads the category of the product the line item sells, a table the measure joins",
        "expression": "sum(case(p.category_id = 1, unit_price * quantity))",
        "joins": [
          {
            "alias": "p",
            "entity": "products",
            "via": "same_product"
          }
        ],
        "concept": {
          "typeFamily": "DECIMAL"
        }
      },
      {
        "name": "revenue_germany",
        "label": "Revenue of German customers",
        "description": "Revenue of the line items whose order belongs to a customer in Germany: reads the country of the customer of the order of the line item, a chain of two tables the measure joins",
        "expression": "sum(case(c.country = 'Germany', unit_price * quantity))",
        "joins": [
          {
            "alias": "o",
            "entity": "orders",
            "via": "same_order"
          },
          {
            "alias": "c",
            "entity": "customers",
            "via": "same_customer",
            "from": "o"
          }
        ],
        "concept": {
          "typeFamily": "DECIMAL"
        }
      },
      {
        "name": "revenue_per_order",
        "label": "Revenue per order",
        "description": "Revenue divided by the number of orders in the query: a derived measure of two tables",
        "expression": "to_double(agg(order_details.revenue)) / agg(orders.order_count)",
        "concept": {
          "typeFamily": "FLOAT"
        }
      }
    ]
  }
}
