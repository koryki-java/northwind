FIND order_details d, d VIA same_order orders o, o VIA same_customer customers c
FILTER c.company_name LIKE 'A%'
FETCH
sum(to_decimal(multiply(to_decimal(d.unit_price, 32,12), to_decimal(d.quantity, 32,12)), 32,12)) OVER (PARTITION c.company_name) sum,
count(c.company_name) OVER (PARTITION to_decimal(d.unit_price, 32,12) ORDER c.company_name ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)
