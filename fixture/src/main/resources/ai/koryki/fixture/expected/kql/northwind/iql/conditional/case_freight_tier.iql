// Bucket each order's freight cost into a shipping tier — a searched CASE with two predicates
// (case(cond1, result1, cond2, result2, else)).

SELECT
 orders o
  OUT o.order_id 1
  OUT o.freight 2
  FILTER
    o.order_id < 10253
  ORDER o.order_id ASC 1
ALL
 OUT case(o.freight > 100, 'premium', o.freight > 30, 'standard', 'economy') freight_tier 3