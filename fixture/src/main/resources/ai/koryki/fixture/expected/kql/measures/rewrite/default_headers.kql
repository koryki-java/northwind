WITH
aggd1 AS (
 FIND customers c, c VIA same_customer orders o, o VIA same_order order_details od
 FILTER c.country = 'Germany'
 FETCH DISTINCT o.order_id i1, c.country k1, o.ship_city k2, o.freight c1),
aggm1 AS (FIND aggd1 x FETCH x.k1 k1, x.k2 k2, sum(x.c1) v1),
aggd2 AS (
 FIND customers c, c VIA same_customer orders o, o VIA same_order order_details od
 FILTER c.country = 'Germany'
 FETCH DISTINCT od.order_id i1, od.product_id i2, c.country k1, o.ship_city k2, od.quantity c1),
aggm2 AS (FIND aggd2 x FETCH x.k1 k1, x.k2 k2, sum(x.c1) v2),
aggu AS (FIND aggm1 a FETCH a.k1 k1, a.k2 k2, a.v1 v1, to_integer(NULL) v2
 UNIONALL
 FIND aggm2 a FETCH a.k1 k1, a.k2 k2, to_decimal(NULL, 18, 4) v1, a.v2 v2)
FIND aggu t
 FETCH t.k1 country, t.k2 city, max(t.v1) total_freight, max(t.v2) u, max(t.v1) / 2 half