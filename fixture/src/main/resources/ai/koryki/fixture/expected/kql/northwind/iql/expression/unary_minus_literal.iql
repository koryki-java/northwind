// Unary minus: negative number literal in filter comparison.
// All order details with unit price above -1 (unary minus on numeric literal).

SELECT
 order_details od
  OUT od.order_id 1
  OUT od.unit_price 2
  FILTER
    od.unit_price > negate(1)
  JOIN same_order orders o
    FILTER
      o.customer_id = 'VINET'
  OWNER
