WITH
aggd1 AS (
 FIND customers c, c VIA same_customer orders o, o VIA same_order order_details od
 FETCH DISTINCT o.order_id i1, o.freight c1),
aggm1 AS (FIND aggd1 x FETCH sum(x.c1) v1),
aggd2 AS (
 FIND customers c, c VIA same_customer orders o, o VIA same_order order_details od
 FETCH DISTINCT od.order_id i1, od.product_id i2, od.quantity c1, od.unit_price c2),
aggm2 AS (FIND aggd2 x FETCH sum(x.c1) v2, sum(x.c2 * x.c1) v3),
aggu AS (FIND aggm1 a FETCH a.v1 v1, to_integer(NULL) v2, to_decimal(NULL, 18, 4) v3
 UNIONALL
 FIND aggm2 a FETCH to_decimal(NULL, 18, 4) v1, a.v2 v2, a.v3 v3)
FIND aggu t
 FETCH max(t.v1) freight, max(t.v2) units, max(t.v3) revenue