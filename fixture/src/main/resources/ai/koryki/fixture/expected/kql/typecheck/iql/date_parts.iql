// The calendar parts, all ISO-8601. 2026-05-17 is a Sunday — the case the engines disagree on
// most, answering 0, 1 or 7 natively — and it falls in ISO week 20, quarter 2, on day 137.

SELECT
 check_type t
  OUT quarter(t.type_date) q 1
  OUT week(t.type_date) wk 2
  OUT dayofweek(t.type_date) dow 3
  OUT day(t.type_date) dom 4
  OUT dayofyear(t.type_date) doy 5
  OUT week_begin(t.type_date) wk_begin 6
  OUT week_end(t.type_date) wk_end 7