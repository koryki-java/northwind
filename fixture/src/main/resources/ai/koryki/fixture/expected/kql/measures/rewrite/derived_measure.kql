WITH
aggd1 AS (
 FIND customers c, c VIA same_customer orders o, o VIA same_order order_details od
 FETCH DISTINCT od.order_id i1, od.product_id i2, c.country k1, od.unit_price c1, od.quantity c2),
aggm1 AS (FIND aggd1 x FETCH x.k1 k1, sum(x.c1 * x.c2) v1),
aggd2 AS (
 FIND customers c, c VIA same_customer orders o, o VIA same_order order_details od
 FETCH DISTINCT o.order_id i1, c.country k1, o.order_id c1),
aggm2 AS (FIND aggd2 x FETCH x.k1 k1, count(x.c1) v2),
aggu AS (FIND aggm1 a FETCH a.k1 k1, a.v1 v1, to_integer(NULL) v2
 UNIONALL
 FIND aggm2 a FETCH a.k1 k1, to_decimal(NULL, 18, 4) v1, a.v2 v2)
FIND aggu t
 FETCH t.k1 country, (to_double(max(t.v1)) / max(t.v2)) revenue_per_order