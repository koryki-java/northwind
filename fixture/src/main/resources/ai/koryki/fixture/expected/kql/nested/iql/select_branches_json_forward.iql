// select_branches_json without the position from the end, which Trino, Snowflake and SQL Server do not
// have in JSON (see select_branches_json). What every dialect with a JSON column can answer, asked
// from the start.

SELECT
 check_complex t
  OUT t.nr 1
  OUT t.branches_json@1@city first_city 2
  OUT t.branches_json@1@geo@lat first_lat 3
  OUT t.branches_json@2@zip second_zip 4
  OUT t.branches_json@4@city fourth_city 5