// FIND with list of links with alias

SELECT
 orders o
  FILTER
    o.order_date BETWEEN "2023-01-01" AND "2023-12-31"
  JOIN same_order order_details od
    OUT sum(to_decimal(multiply(to_decimal(od.unit_price, 32, 8), to_decimal(od.quantity, 32, 8)), 32, 8)) 2
    ORDER sum(to_decimal(multiply(to_decimal(od.unit_price, 32, 8), to_decimal(od.quantity, 32, 8)), 32, 8)) DESC 2
     JOIN same_product products p
        JOIN same_category categories c
          OUT c.category_name 1
          GROUP c.category_name 1
        OWNER
     OWNER
  OWNER
