WITH
aggd1 AS (
 FIND customers c, c VIA same_customer orders o, o VIA same_order order_details od
 FILTER c.country = 'Germany'
 FETCH DISTINCT o.order_id i1, c.country k1, o.freight c1),
aggm1 AS (FIND aggd1 x FETCH x.k1 k1, sum(case(x.c1 > 100, x.c1)) v1, sum(x.c1) v2)
FIND aggm1 t
 FETCH t.k1 country, max(t.v1) big, max(t.v2) total